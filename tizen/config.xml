<?xml version="1.0" encoding="UTF-8"?>
<!--
  Client Proscaenia per Samsung Smart TV (Tizen 5.0, UE43RU7400), ancora in fase di prova tecnica.
  App web impacchettata (.wgt) con interfaccia allineata all'app Android TV (catalogo, scheda, player
  con OSD); la schermata Diagnostica conserva le verifiche di CORS, login, licenze DRM e riproduzione.
  Non sostituisce né modifica l'app Android.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://icarocomix.com/proscaenia-tizen-prova" version="0.2.0" viewmodes="maximized">
    <tizen:application id="PrScTizen0.ProscaeniaProva" package="PrScTizen0" required_version="2.3"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Proscaenia</name>
    <description>Catalogo e riproduzione Proscaenia; diagnostica CORS, DRM Widevine/PlayReady e log.</description>

    <feature name="http://tizen.org/feature/screen.size.all"/>

    <!-- Accesso di rete verso qualunque origine: API, CDN video, server licenze e ricevitore log sul PC. -->
    <access origin="*" subdomains="true"/>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.read"/>
    <tizen:privilege name="http://tizen.org/privilege/filesystem.write"/>
    <tizen:privilege name="http://tizen.org/privilege/externalstorage"/>
    <tizen:privilege name="http://tizen.org/privilege/mediastorage"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/drmplay"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>

    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
