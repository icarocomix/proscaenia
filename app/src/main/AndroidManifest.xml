<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Riproduzione in background: servizio in primo piano di tipo mediaPlayback e wake lock
         (CPU e Wi-Fi) per continuare lo streaming a schermo spento. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Da Android 13 la notifica multimediale richiede il permesso esplicito. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Backup disattivato: le credenziali cifrate dipendono da una chiave del Keystore che non
         viene ripristinata su un altro dispositivo, quindi un backup sarebbe illeggibile. -->
    <application
        android:name=".ProscaeniaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Proscaenia">

        <!-- Gestisco io i cambi di configurazione: ruotando lo schermo la UI Compose si ridispone
             senza ricreare l'activity né interrompere il collegamento al player. -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Cast verso il Default Media Receiver di Google: nessun receiver personalizzato. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="androidx.media3.cast.DefaultCastOptionsProvider" />
    </application>
</manifest>
